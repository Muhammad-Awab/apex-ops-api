# Copy to .env (scripts/init_secrets.sh does it for you). No secrets go in this file:
# the DB password lives in secrets/db_password.txt and is mounted as a Docker secret.
APP_IMAGE=apex-ops-api
# Managed by scripts/deploy.sh and scripts/rollback.sh - do not edit by hand during a release.
APP_VERSION=1.0.0
APP_PORT=8080
ENVIRONMENT=local
LOG_LEVEL=INFO
DB_USER=apex
DB_NAME=apex_ops
